generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  profileId   String             @id @default(uuid())
  cognitoSub  String             @unique
  firstName   String?
  lastName    String?
  email       String             @unique
  gender      String?
  dateOfBirth String?
  state       String?
  city        String?
  travelStyle TravelStyle[]
  preferences TravelPreference[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  trips       Trip[]
  budgets     Budgets[]
  notes       Note[]
  travelers   Travelers[]
}

enum TravelStyle {
  BEACH_AND_SUN
  ADVENTURE
  CITY_BREAKS
  FOOD_AND_DRINK
  CULTURE_AND_ART
  ECO_TRAVEL
  BUSINESS
  ROMANTIC
  WINTER_SPORTS
  PHOTOGRAPHY
}

enum TravelPreference {
  SOLO_TRAVELER
  TRAVELING_WITH_KIDS
  BUDGET_CONSCIOUS
}

model Trip {
  tripId String @id @default(uuid())

  profileId String
  profile   Profile @relation(fields: [profileId], references: [profileId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tripName    String
  destination Destination[]
  travelers   Travelers[]
  budgets     Budgets[]
  notes       Note[]

  status String?
}

model Budgets {
  budgetId  String @id @default(uuid())
  tripId    String
  profileId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  total         Float
  flights       Float
  accommodation Float
  food          Float
  activities    Float
  misc          Float

  trip    Trip    @relation(fields: [tripId], references: [tripId], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [profileId], onDelete: Cascade)

  @@unique([tripId, profileId])
}

model Note {
  noteId    String @id @default(uuid())
  tripId    String
  profileId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  text String

  trip    Trip    @relation(fields: [tripId], references: [tripId], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [profileId], onDelete: Cascade)

  @@unique([tripId, profileId])
  @@map("notes")
}

model Travelers {
  travelerId String @id @default(uuid())
  tripId     String
  profileId  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email String

  trip    Trip    @relation(fields: [tripId], references: [tripId], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [profileId], onDelete: Cascade)

  @@unique([tripId, profileId])
  @@map("Travelers")
}

model Destination {
  destinationId String @id @default(uuid())
  tripId        String

  name        String
  latitude    Float
  longitude   Float
  arrivalDate String
  leaveDate   String
  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [tripId], onDelete: Cascade)

  @@map("destinations")
}

model Activity {
  activityId    String       @id @default(uuid())
  destinationId String

  day           Int
  startTime     String
  activityType  ActivityType
  description   String
  notes         String?

  destination Destination @relation(fields: [destinationId], references: [destinationId], onDelete: Cascade)

  @@map("activity")
}

 enum ActivityType {
  FLIGHT          @map("flight")
  HOTEL_CHECK_IN  @map("hotel check in")
  HOTEL_CHECK_OUT @map("hotel check out")
  FOOD_AND_DRINK  @map("food & drink")
  ACTIVITY        @map("activity")
  OTHER           @map("other")
}