generator client {
  provider = "prisma-client-js"
   binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  profileId          String    @id @default(uuid())
  cognitoSub  String    @unique
  firstName   String?
  lastName    String?
  email       String    @unique
  gender      String?
  dateOfBirth String?
  state       String?
  city        String?
  travelStyle TravelStyle[]
  preferences TravelPreference[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  trips       Trip[]
  budgets     Budgets[]
}

enum TravelStyle {
  BEACH_AND_SUN
  ADVENTURE
  CITY_BREAKS
  FOOD_AND_DRINK
  CULTURE_AND_ART
  ECO_TRAVEL
  BUSINESS
  ROMANTIC
  WINTER_SPORTS
  PHOTOGRAPHY
}

enum TravelPreference {
  SOLO_TRAVELER
  TRAVELING_WITH_KIDS
  BUDGET_CONSCIOUS
}

model Trip {
  tripId     String   @id @default(uuid())

  profileId  String 
  profile     Profile  @relation(fields: [profileId], references: [profileId])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tripName   String
  destination Json[]
  travelers   String[]
  budgets     Budgets[]
  notes       Json[]

  status      String?
}


model Budgets {
  budgetId      String   @id @default(uuid())
  tripId        String
  profileId     String

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  total         Float
  flights       Float
  accommodation Float
  food          Float
  activities    Float
  misc          Float

  trip          Trip     @relation(fields: [tripId], references: [tripId], onDelete: Cascade)
  profile       Profile  @relation(fields: [profileId], references: [profileId], onDelete: Cascade)
 @@unique([tripId, profileId])

}


